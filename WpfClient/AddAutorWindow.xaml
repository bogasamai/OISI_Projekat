<Window x:Class="WpfClient.AddAutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj autora" Height="380" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Unesite podatke o autoru" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Ime:</TextBlock>
                <TextBox Name="TxtIme" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Prezime:</TextBlock>
                <TextBox Name="TxtPrezime" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Broj licne karte:</TextBlock>
                <TextBox Name="TxtBrojLicne" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Datum rodjenja:</TextBlock>
                <DatePicker Name="DpDatum" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Telefon:</TextBlock>
                <TextBox Name="TxtTelefon" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">E-mail:</TextBlock>
                <TextBox Name="TxtEmail" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center">Godine iskustva:</TextBlock>
                <TextBox Name="TxtGodine" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="142" VerticalAlignment="Center">Adresa: </TextBlock>
                <TextBox Name="TxtAdresa" Width="240" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="BtnConfirm" Content="Potvrdi" Width="80" Margin="0,0,8,0" IsEnabled="False" Click="BtnConfirm_Click" />
            <Button Name="BtnCancel" Content="Odustani" Width="80" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>