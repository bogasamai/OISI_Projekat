<Window x:Class="WpfClient.AddAutorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource lblAddAutorTitle}" Height="380" Width="420" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource lblEnterData}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblIme}" />
                <TextBox Name="TxtIme" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblPrezime}" />
                <TextBox Name="TxtPrezime" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblBrojLicne}" />
                <TextBox Name="TxtBrojLicne" Width="240" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblDatumRodjenja}" />
                <DatePicker Name="DpDatum" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblTelefon}" />
                <TextBox Name="TxtTelefon" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblEmail}" />
                <TextBox Name="TxtEmail" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource lblIskustvo}" />
                <TextBox Name="TxtGodine" Width="240" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Width="142" VerticalAlignment="Center" Text="{DynamicResource lblAdresa}" />
                <TextBox Name="TxtAdresa" Width="240" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="BtnConfirm" Content="{DynamicResource btnConfirm}" Width="80" Margin="0,0,8,0" IsEnabled="False" Click="BtnConfirm_Click" />
            <Button Name="BtnCancel" Content="{DynamicResource btnCancel}" Width="80" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>