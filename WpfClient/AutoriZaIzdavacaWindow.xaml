<Window x:Class="WpfClient.AutoriZaIzdavacaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autori izdavača" Height="450" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Pretraga:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Name="txtPretraga" Width="350" TextChanged="TxtPretraga_TextChanged" />
        </StackPanel>

        <DataGrid Name="dgAutori" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ime" Binding="{Binding Ime}" Width="120" />
                <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" Width="120" />
                <DataGridTextColumn Header="Datum rođenja" Binding="{Binding DatumRodjenja, StringFormat={}{0:dd.MM.yyyy}}" Width="120" />
                <DataGridTextColumn Header="Adresa" Binding="{Binding AdresaStanovanja.Ulica}" Width="150" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Telefon}" Width="120" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Zatvori" Width="100" Click="BtnZatvori_Click" />
        </StackPanel>
    </Grid>
</Window>
