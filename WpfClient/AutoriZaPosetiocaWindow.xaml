<Window x:Class="WpfClient.AutoriZaPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource lblAutoriizlistezelja}" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource lblSearch}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Name="txtPretraga" Width="300" TextChanged="TxtPretraga_TextChanged" />
        </StackPanel>

        <DataGrid Name="dgAutori" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource colIme}" Binding="{Binding Ime}" Width="150" />
                <DataGridTextColumn Header="{DynamicResource colPrezime}" Binding="{Binding Prezime}" Width="150" />
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource btnClose}" Width="100" Click="BtnZatvori_Click" />
        </StackPanel>
    </Grid>
</Window>