<Window x:Class="WpfClient.DodajKnjiguUZeljuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource lblDodavanjeKnjige}" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="lbKnjige" Grid.Row="0" Margin="0,0,0,15" SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding ISBN}" FontWeight="Bold" Width="80"/>
                        <TextBlock Text="{Binding Naziv}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource btnCancel}" Width="80" Margin="0,0,10,0" Padding="5" Click="BtnOdustani_Click"/>
            <Button Content="{DynamicResource btnAdd}" Width="80" Padding="5" Click="BtnDodaj_Click"/>
        </StackPanel>
    </Grid>
</Window>