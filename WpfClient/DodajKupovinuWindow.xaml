<Window x:Class="WpfClient.DodajKupovinuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unos kupovine" Height="220" Width="420" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ISBN:" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Name="txtISBN" IsReadOnly="True" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Naziv:" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Name="txtNaziv" IsReadOnly="True" Margin="0,8,0,0" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ocena (1-5):" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="2" Grid.Column="1" Name="txtOcena" Margin="0,8,0,0" PreviewTextInput="TxtOcena_PreviewTextInput" TextChanged="TxtOcena_TextChanged" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum kupovine:" VerticalAlignment="Center" Margin="0,12,0,0" />
        <DatePicker Grid.Row="3" Grid.Column="1" Name="dpDatum" SelectedDateChanged="DpDatum_SelectedDateChanged" Margin="0,12,0,0" />

        <!-- Buttons row -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Name="btnOdustani" Content="Odustani" Width="100" Click="BtnOdustani_Click" Margin="0,0,8,0" />
            <Button Name="btnPotvrdi" Content="Potvrdi" Width="100" Click="BtnPotvrdi_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>