<Window x:Class="WpfClient.DodajPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodavanje posetioca" Height="434" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="10,0,0,10"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Broj članske karte *" Grid.Row="0"/>
        <TextBox Name="txtBrojKarte" TextChanged="ValidateForm" Grid.Row="0" Grid.Column="1"/>

        <TextBlock Text="Ime *" Grid.Row="1"/>
        <TextBox Name="txtIme" TextChanged="ValidateForm" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Text="Prezime *" Grid.Row="2"/>
        <TextBox Name="txtPrezime" TextChanged="ValidateForm" Grid.Row="2" Grid.Column="1"/>

        <TextBlock Text="Datum rođenja *" Grid.Row="3"/>
        <DatePicker Name="dpDatumRodjenja" SelectedDateChanged="ValidateForm" Grid.Row="3" Grid.Column="1"/>

        <TextBlock Text="Kontakt telefon *" Grid.Row="4"/>
        <TextBox Name="txtTelefon" TextChanged="ValidateForm" Grid.Row="4" Grid.Column="1"/>

        <TextBlock Text="Email *" Grid.Row="5"/>
        <TextBox Name="txtEmail" TextChanged="ValidateForm" Grid.Row="5" Grid.Column="1"/>

        <TextBlock Text="Status *" Grid.Row="6"/>
        <ComboBox Name="cbStatus" Grid.Row="6" Grid.Column="1">
            <ComboBoxItem Content="Regularni" Tag="R" IsSelected="True"/>
            <ComboBoxItem Content="VIP" Tag="V"/>
        </ComboBox>

        <TextBlock Text="Adresa *" Grid.Row="7"/>
        <TextBox Name="txtAdresa" TextChanged="ValidateForm" Grid.Row="7" Grid.Column="1">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Resources>
                        <VisualBrush x:Key="PlaceholderBrush" AlignmentX="Left" Stretch="None">
                            <VisualBrush.Visual>
                                <TextBlock Text="Ulica, Broj, Grad, Država" Foreground="Gray" FontStyle="Italic" Opacity="0.6"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Style.Resources>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Odustani" Width="90" Height="30" Margin="0,0,10,0" Click="BtnOdustani_Click" Background="#F0F0F0"/>
            <Button Name="btnPotvrdi" Content="Potvrdi" IsEnabled="False" Width="90" Height="30" Background="#A0C4FF" FontWeight="Bold" Click="BtnPotvrdi_Click"/>
        </StackPanel>
    </Grid>
</Window>