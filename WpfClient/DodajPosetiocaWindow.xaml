<Window x:Class="WpfClient.DodajPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodavanje posetioca" Height="450" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Broj članske karte *" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox Name="txtBrojKarte" TextChanged="ValidateForm" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Ime *" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox Name="txtIme" TextChanged="ValidateForm" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Prezime *" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox Name="txtPrezime" TextChanged="ValidateForm" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Datum rođenja *" Grid.Row="3" VerticalAlignment="Center"/>
        <DatePicker Name="dpDatumRodjenja" SelectedDateChanged="ValidateForm" Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Kontakt telefon *" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox Name="txtTelefon" TextChanged="ValidateForm" Grid.Row="4" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Email *" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox Name="txtEmail" TextChanged="ValidateForm" Grid.Row="5" Grid.Column="1" Margin="10,0,0,0"/>

        <TextBlock Text="Status *" Grid.Row="6" VerticalAlignment="Center"/>
        <ComboBox Name="cbStatus"  Grid.Row="6" Grid.Column="1" Margin="10,0,0,0">
            <ComboBoxItem Content="Regularni" Tag="R" IsSelected="True"/>
            <ComboBoxItem Content="VIP" Tag="V"/>
        </ComboBox>

        <TextBlock Text="Adresa *" Grid.Row="7" VerticalAlignment="Center"/>
        <TextBox Name="txtAdresa" TextChanged="ValidateForm" Grid.Row="7" Grid.Column="1" Margin="10,0,0,0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Odustani"  Width="80" Margin="0,0,10,0" Click="BtnOdustani_Click" Padding="5"/>
            <Button Name="btnPotvrdi" Content="Potvrdi" IsEnabled="False" Width="80" Background="#A0C4FF" Click="BtnPotvrdi_Click" Padding="5"/>
        </StackPanel>
    </Grid>
</Window>