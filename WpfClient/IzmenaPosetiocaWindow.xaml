<Window x:Class="WpfClient.IzmenaPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena posetioca" Height="500" Width="450" 
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Informacije">
                <StackPanel Margin="10">
                    <TextBlock Text="Broj članske karte *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtBrojKarte" Padding="3" TextChanged="ValidateForm"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Ime *" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtIme" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Prezime *" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPrezime" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Datum rođenja *" Margin="0,5,0,2"/>
                    <DatePicker x:Name="dpDatumRodjenja" SelectedDateChanged="ValidateForm"/>

                    <TextBlock Text="Kontakt telefon *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtTelefon" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="Email *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtEmail" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="Status *" Margin="0,5,0,2"/>
                    <ComboBox x:Name="cbStatus" SelectionChanged="ValidateForm">
                        <ComboBoxItem Content="Redovan" Tag="R" IsSelected="True"/>
                        <ComboBoxItem Content="VIP" Tag="V"/>
                    </ComboBox>

                    <TextBlock Text="Adresa (Ulica, Broj, Grad, Država) *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtAdresa" Padding="3" TextChanged="ValidateForm"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnOdustani" Content="Odustani" Width="80" Margin="0,0,10,0" Click="BtnOdustani_Click"/>
                        <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="80" IsEnabled="False" Click="BtnPotvrdi_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Kupljene">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cancel Purchase Button -->
                    <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Grid.Row="0">
                        <Button x:Name="btnPonistiKupovinu" Content="Poništi kupovinu" Width="120" Padding="6,4" 
                    Click="BtnPonistiKupovinu_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Purchased Books Table -->
                    <DataGrid x:Name="dgKupljeneKnjige" Grid.Row="1" Margin="10,0,10,10" 
                  AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Single" SelectionChanged="DgKupljeneKnjige_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Knjiga.ISBN}" Width="100"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Knjiga.Naziv}" Width="100"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding DatumKupovine, StringFormat={}{0:dd.MM.yyyy}}" Width="80"/>
                            <DataGridTextColumn Header="Ocena" Binding="{Binding Ocena}" Width="60"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Knjiga.Cena, StringFormat={}{0:F2} RSD}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Statistics Panel -->
                    <Grid Grid.Row="2" Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Prosečna ocena: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblProsecnaOcena" Text="0.0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="Ukupna potrošnja: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblUkupnaPotrosnja" Text="0.00 RSD" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>



            <TabItem Header="Želje">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Grid.Row="0">
                        <Button Content="Dodaj" Width="80" Padding="6,4" Margin="0,0,5,0"/>
                        <Button Content="Obriši" Width="80" Padding="6,4" Margin="0,0,5,0"/>
                        <Button Content="Kupovina" Width="80" Padding="6,4"/>
                    </StackPanel>

                    <TextBlock Text="Lista želja će biti prikazana ovde." VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>