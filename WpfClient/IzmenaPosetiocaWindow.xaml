<Window x:Class="WpfClient.IzmenaPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena posetioca" Height="500" Width="450" 
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Informacije">
                <StackPanel Margin="10">
                    <TextBlock Text="Broj članske karte *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtBrojKarte" Padding="3" TextChanged="ValidateForm"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Ime *" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtIme" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Prezime *" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPrezime" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Datum rođenja *" Margin="0,5,0,2"/>
                    <DatePicker x:Name="dpDatumRodjenja" SelectedDateChanged="ValidateForm"/>

                    <TextBlock Text="Kontakt telefon *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtTelefon" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="Email *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtEmail" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="Status *" Margin="0,5,0,2"/>
                    <ComboBox x:Name="cbStatus" SelectionChanged="ValidateForm">
                        <ComboBoxItem Content="Redovan" Tag="R" IsSelected="True"/>
                        <ComboBoxItem Content="VIP" Tag="V"/>
                    </ComboBox>

                    <TextBlock Text="Adresa (Ulica, Broj, Grad, Država) *" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtAdresa" Padding="3" TextChanged="ValidateForm"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnOdustani" Content="Odustani" Width="80" Margin="0,0,10,0" Click="BtnOdustani_Click"/>
                        <Button x:Name="btnPotvrdi" Content="Potvrdi" Width="80" IsEnabled="False" Click="BtnPotvrdi_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Kupljene">
                <TextBlock Text="Lista kupljenih knjiga će biti prikazana ovde." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>

            <TabItem Header="Želje">
                <TextBlock Text="Lista želja će biti prikazana ovde." VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>