<Window x:Class="WpfClient.IzmenaPosetiocaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena posetioca" Height="500" Width="450" 
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="{DynamicResource tabInformacije}">
                <StackPanel Margin="10">
                    <TextBlock Text="{DynamicResource lblBrojClanskeReq}" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtBrojKarte" Padding="3" TextChanged="ValidateForm"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{DynamicResource lblImeReq}" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtIme" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{DynamicResource lblPrezimeReq}" Margin="0,5,0,2"/>
                            <TextBox x:Name="txtPrezime" Padding="3" TextChanged="ValidateForm"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource lblDatumRodjenjaReq}" Margin="0,5,0,2"/>
                    <DatePicker x:Name="dpDatumRodjenja" SelectedDateChanged="ValidateForm"/>

                    <TextBlock Text="{DynamicResource lblTelefonReq}" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtTelefon" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="{DynamicResource lblEmailReq}" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtEmail" Padding="3" TextChanged="ValidateForm"/>

                    <TextBlock Text="{DynamicResource lblStatusReq}" Margin="0,5,0,2"/>
                    <ComboBox x:Name="cbStatus" SelectionChanged="ValidateForm">
                        <ComboBoxItem Content="{DynamicResource statusRegular}" Tag="R" IsSelected="True"/>
                        <ComboBoxItem Content="{DynamicResource statusVIP}" Tag="V"/>
                    </ComboBox>

                    <TextBlock Text="{DynamicResource lblAdresaReq}" Margin="0,5,0,2"/>
                    <TextBox x:Name="txtAdresa" Padding="3" TextChanged="ValidateForm"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnOdustani" Content="{DynamicResource btnCancel}" Width="80" Margin="0,0,10,0" Click="BtnOdustani_Click"/>
                        <Button x:Name="btnPotvrdi" Content="{DynamicResource btnConfirm}" Width="80" IsEnabled="False" Click="BtnPotvrdi_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource tabKupljene}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cancel Purchase Button -->
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Grid.Row="0">
                        <Button x:Name="btnPonistiKupovinu" Content="{DynamicResource btnPonistiKupovinu}" Width="120" Padding="6,4" 
                    Click="BtnPonistiKupovinu_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- Purchased Books Table -->
                    <DataGrid x:Name="dgKupljeneKnjige" Grid.Row="1" Margin="10,0,10,10" 
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DgKupljeneKnjige_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Knjiga.ISBN}" Width="100"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Knjiga.Naziv}" Width="100"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding DatumKupovine, StringFormat={}{0:dd.MM.yyyy}}" Width="80"/>
                            <DataGridTextColumn Header="Ocena" Binding="{Binding Ocena}" Width="60"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Knjiga.Cena, StringFormat={}{0:F2} RSD}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Statistics Panel -->
                    <Grid Grid.Row="2" Margin="10,0,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource lblProsecnaOcenaText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblProsecnaOcena" Text="0.0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="{DynamicResource lblUkupnaPotrosnjaText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="lblUkupnaPotrosnja" Text="0.00 RSD" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>



            <TabItem Header="{DynamicResource tabZelje}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="10,10,10,5" Grid.Row="0">
                        <Button x:Name="BtnZeljaDodaj" Content="{DynamicResource btnAdd}" Width="80" Padding="6,4" Margin="0,0,5,0" Click="BtnZeljaDodaj_Click"/>
                        <Button x:Name="BtnZeljaObrisi" Content="{DynamicResource btnDelete}" Width="80" Padding="6,4" Margin="0,0,5,0" Click="BtnZeljaObrisi_Click" IsEnabled="False"/>
                        <Button x:Name="BtnZeljaKupovina" Content="{DynamicResource btnKupovina}" Width="80" Padding="6,4" Click="BtnZeljaKupovina_Click" IsEnabled="False"/>
                    </StackPanel>

                    <DataGrid x:Name="dgZelja" Grid.Row="1" Margin="10,0,10,10" 
                              AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True"
                              SelectionChanged="DgZelja_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120" />
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="*" />
                            <DataGridTextColumn Header="Žanr" Binding="{Binding Zanr}" Width="120" />
                            <DataGridTextColumn Header="Cena" Binding="{Binding Cena, StringFormat={}{0:F2} RSD}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>