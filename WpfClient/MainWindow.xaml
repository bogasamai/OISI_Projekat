<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource mTitle}" WindowStartupLocation="CenterScreen">

    <!-- Precice za menu bar ( Ctrl+S,Ctrl+N,Ctrl+C ) -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="New" />
        <KeyBinding Modifiers="Control" Key="S" Command="Save" />
        <KeyBinding Modifiers="Control" Key="C" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="MenuCommand_New_Executed" />
        <CommandBinding Command="Save" Executed="MenuCommand_Save_Executed" />
        <CommandBinding Command="Close" Executed="MenuCommand_Exit_Executed" />
    </Window.CommandBindings>

    <DockPanel>

        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource mFile}">
                <MenuItem Header="{DynamicResource mNew}" InputGestureText="Ctrl+N" Click="MenuItem_New_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resources/add_icon.png" Width="16"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="{DynamicResource mSave}" InputGestureText="Ctrl+S" Click="MenuItem_Save_Click" />

                <MenuItem Header="{DynamicResource mOpen}">
                    <MenuItem Header="{DynamicResource tabPosetioci}" Click="MenuItem_OpenPosetioci_Click" />
                    <MenuItem Header="{DynamicResource tabAutori}" Click="MenuItem_OpenKnjige_Click" />
                    <MenuItem Header="{DynamicResource tabKnjige}" Click="MenuItem_OpenAutori_Click" />
                    <MenuItem Header="{DynamicResource tabAutorisalistezelja}" Click="MenuItem_OpenAutoriZaPosetioca_Click" />
                    <MenuItem Header="{DynamicResource tabIzdavaci}" Click="MenuItem_OpenIzdavaci_Click" />
                    <MenuItem Header="{DynamicResource tabPosetiocinalistizelja}" Click="MenuItem_OpenPosetiociNaListiZelja_Click"/>
                </MenuItem>

                <Separator />

                <MenuItem Header="{DynamicResource mExit}" InputGestureText="Ctrl+C" Click="MenuItem_Exit_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resources/close_icon.png" Width="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="{DynamicResource btnEdit}">
                <MenuItem Header="{DynamicResource mEdit}" Click="Toolbar_Edit_Click" />
                <MenuItem Header="{DynamicResource mDelete}" Click="Toolbar_Delete_Click" />
            </MenuItem>

            <MenuItem Header="{DynamicResource btnHelp}">
                <MenuItem Header="{DynamicResource mAbout}" Click="MenuItem_About_Click" />
            </MenuItem>
        </Menu>

        <Grid DockPanel.Dock="Top" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ToolBarTray Background="Transparent" Grid.Column="0">
                <ToolBar Background="Transparent" ToolBarTray.IsLocked="True">
                    <Button Name="BtnAdd" Click="Toolbar_Add_Click" Padding="8,4" ToolTip="Kreiraj novi entitet (Ctrl+N)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Resources/add_icon.png" Width="20" Height="20" Margin="0,0,4,0" />
                            <TextBlock Text="{DynamicResource btnAdd}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Name="BtnEdit" Click="Toolbar_Edit_Click" Padding="8,4" ToolTip="Izmeni označeni entitet (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource btnEdit}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Name="BtnDelete" Click="Toolbar_Delete_Click" Padding="8,4" ToolTip="Obriši označeni entitet (Ctrl+D)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource btnDelete}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator />
                </ToolBar>
            </ToolBarTray>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                <Button Name="btnSrpski" Content="SR" Click="btnSrpski_Click" Width="30" Margin="0,0,5,0" Background="#E0E0E0" FontWeight="Bold"/>
                <Button Name="btnEngleski" Content="EN" Click="btnEngleski_Click" Width="30" Margin="0,0,10,0" Background="#E0E0E0" FontWeight="Bold"/>
                
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Background="White" Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="12" Margin="8,0,4,0" VerticalAlignment="Center" Foreground="#888888" />
                        <TextBox Name="SearchTextBox" 
                         Width="220" 
                         BorderThickness="0" 
                         Padding="2,6" 
                         VerticalContentAlignment="Center"
                         Background="Transparent" />
                    </StackPanel>
                </Border>

                <Button Name="BtnSearch" 
                Click="BtnSearch_Click" 
                Padding="12,5" 
                Background="#E0E0E0"
                ToolTip="Pretraži (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource btnSearch}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F5F5F5">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock Name="StatusText" Text="Spreman" Margin="5,0,0,0" Foreground="#333333" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <TextBlock Name="StatusDateTime" Margin="0,0,5,0" Foreground="#333333" />
            </StatusBarItem>
        </StatusBar>

        <!-- Central content: tabs -->
        <Grid>
            <TabControl Name="MainTabControl" Margin="8">
                <TabItem Header="{DynamicResource tabPosetioci}" Tag="posetioci">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Name="PosetiociGrid" ItemsSource="{Binding Posetioci}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Sorting="PosetiociGrid_Sorting">
                            <DataGrid.Columns>
                                <!-- SortMemberPath points to real model property; Binding shows display-friendly text -->
                            <DataGridTextColumn Binding="{Binding BrojClanskeKarteDisplay}" SortMemberPath="BrojClanskeKarte" Width="140">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colBrc}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Orientation="Vertical">
                                            <Button Content="▲" Tag="Posetioci:BrojClanskeKarte:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            <Button Content="▼" Tag="Posetioci:BrojClanskeKarte:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding ImeDisplay}" SortMemberPath="Ime" Width="120">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colIme}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Orientation="Vertical">
                                            <Button Content="▲" Tag="Posetioci:Ime:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            <Button Content="▼" Tag="Posetioci:Ime:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PrezimeDisplay}" SortMemberPath="Prezime" Width="120">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colPrezime}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Orientation="Vertical">
                                            <Button Content="▲" Tag="Posetioci:Prezime:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            <Button Content="▼" Tag="Posetioci:Prezime:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                                <DataGridTextColumn Binding="{Binding AdresaDisplay}" Width="*">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{DynamicResource colAdresa}" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding StatusDisplay}" SortMemberPath="Status" Width="100">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colStatus}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Posetioci:Status:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Posetioci:Status:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Grid.Row="1">
                            <Button Name="BtnPosetiociPrev" Content="←" Width="36" Click="BtnPosetiociPrev_Click" />
                            <TextBlock Name="PosetiociPageText" Text="1/1" VerticalAlignment="Center" Margin="8,0" />
                            <Button Name="BtnPosetiociNext" Content="→" Width="36" Click="BtnPosetiociNext_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource tabAutori}" Tag="autori">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Name="AutoriGrid" ItemsSource="{Binding Autori}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Sorting="AutoriGrid_Sorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding ImeDisplay}" SortMemberPath="Ime" Width="120">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colIme}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Autori:Ime:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Autori:Ime:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding PrezimeDisplay}" SortMemberPath="Prezime" Width="120">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colPrezime}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Autori:Prezime:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Autori:Prezime:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{DynamicResource colBrl}" Binding="{Binding BrojLicneKarteDisplay}" Width="150" />
                                <DataGridTextColumn Header="{DynamicResource colDate}" Binding="{Binding DatumRodjenjaDisplay}" Width="120" />
                            <DataGridTextColumn Binding="{Binding EmailDisplay}" SortMemberPath="Email" Width="*">
                                <DataGridTextColumn.Header>
                                    <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colEmail}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Orientation="Vertical">
                                            <Button Content="▲" Tag="Autori:Email:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            <Button Content="▼" Tag="Autori:Email:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Grid.Row="1">
                            <Button Name="BtnAutoriPrev" Content="←" Width="36" Click="BtnAutoriPrev_Click" />
                            <TextBlock Name="AutoriPageText" Text="1/1" VerticalAlignment="Center" Margin="8,0" />
                            <Button Name="BtnAutoriNext" Content="→" Width="36" Click="BtnAutoriNext_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{DynamicResource tabKnjige}" Tag="knjige">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Name="KnjigeGrid" ItemsSource="{Binding Knjige}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Sorting="KnjigeGrid_Sorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding ISBNDisplay}" SortMemberPath="ISBN" Width="120">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colISBN}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Knjige:ISBN:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Knjige:ISBN:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding NazivDisplay}" SortMemberPath="Naziv" Width="*">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colNaziv}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Knjige:Naziv:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Knjige:Naziv:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding CenaDisplay}" SortMemberPath="Cena" Width="100">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colCena}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Knjige:Cena:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Knjige:Cena:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding GodinaIzdanjaDisplay}" SortMemberPath="GodinaIzdanja" Width="100">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colGodizd}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Knjige:GodinaIzdanja:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Knjige:GodinaIzdanja:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding ZanrDisplay}" SortMemberPath="Zanr" Width="120">
                                    <DataGridTextColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource colZanr}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <StackPanel Orientation="Vertical">
                                                <Button Content="▲" Tag="Knjige:Zanr:Asc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                                <Button Content="▼" Tag="Knjige:Zanr:Desc" Click="HeaderSort_Click" Padding="0" Width="16" Height="12" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Grid.Row="1">
                            <Button Name="BtnKnjigePrev" Content="←" Width="36" Click="BtnKnjigePrev_Click" />
                            <TextBlock Name="KnjigePageText" Text="1/1" VerticalAlignment="Center" Margin="8,0" />
                            <Button Name="BtnKnjigeNext" Content="→" Width="36" Click="BtnKnjigeNext_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>