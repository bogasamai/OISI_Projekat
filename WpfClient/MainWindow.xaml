<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sajam knjiga" WindowStartupLocation="CenterScreen">

    <!-- Precice za menu bar ( Ctrl+S,Ctrl+N,Ctrl+C ) -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="New" />
        <KeyBinding Modifiers="Control" Key="S" Command="Save" />
        <KeyBinding Modifiers="Control" Key="C" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="MenuCommand_New_Executed" />
        <CommandBinding Command="Save" Executed="MenuCommand_Save_Executed" />
        <CommandBinding Command="Close" Executed="MenuCommand_Exit_Executed" />
    </Window.CommandBindings>

    <DockPanel>

        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="MenuItem_New_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resources/add_icon.png" Width="16"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="MenuItem_Save_Click" />

                <MenuItem Header="_Open">
                    <MenuItem Header="_Posetioci" Click="MenuItem_OpenPosetioci_Click" />
                    <MenuItem Header="_Knjige" Click="MenuItem_OpenKnjige_Click" />
                    <MenuItem Header="_Autori" Click="MenuItem_OpenAutori_Click" />
                    <MenuItem Header="_Izdavači" Click="MenuItem_OpenIzdavaci_Click" />
                </MenuItem>

                <Separator />

                <MenuItem Header="_Close" InputGestureText="Ctrl+C" Click="MenuItem_Exit_Click">
                    <MenuItem.Icon>
                        <Image Source="/Resources/close_icon.png" Width="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Edit" Click="Toolbar_Edit_Click" />
                <MenuItem Header="_Delete" Click="Toolbar_Delete_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="MenuItem_About_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar with Icons and Search -->
        <ToolBarTray DockPanel.Dock="Top" Background="#F5F5F5">
            <ToolBar Band="0" BandIndex="0">
                <!-- Add Button -->
                <Button Name="BtnAdd" Click="Toolbar_Add_Click" Padding="8,4" ToolTip="Kreiraj novi entitet (Ctrl+N)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/add_icon.png" Width="20" Height="20" Margin="0,0,4,0" />
                        <TextBlock Text="Dodaj" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Edit Button -->
                <Button Name="BtnEdit" Click="Toolbar_Edit_Click" Padding="8,4" ToolTip="Izmeni označeni entitet (Ctrl+E)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✎" FontSize="16" Margin="0,0,4,0" />
                        <TextBlock Text="Izmeni" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Delete Button -->
                <Button Name="BtnDelete" Click="Toolbar_Delete_Click" Padding="8,4" ToolTip="Obriši označeni entitet (Ctrl+D)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑" FontSize="16" Margin="0,0,4,0" />
                        <TextBlock Text="Obriši" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Separator Margin="8,0" />

                <!-- Search Field with Icon and Search Button -->
                <Grid VerticalAlignment="Center" Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Icon (Lupa) -->
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Margin="6,0,2,0" VerticalAlignment="Center" Foreground="#666666" />

                    <!-- TextBox for Search -->
                    <TextBox Name="SearchTextBox" Grid.Column="1" Padding="4,4,6,4" VerticalAlignment="Center" Foreground="#333333" />

                    <!-- Search Button -->
                    <Button Name="BtnSearch" Grid.Column="2" Click="BtnSearch_Click" Padding="6,4" Margin="6,0,0,0" ToolTip="Pretrazi (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔎" FontSize="14" Margin="0,0,4,0" />
                            <TextBlock Text="Pretraga" />
                        </StackPanel>
                    </Button>
                </Grid>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F5F5F5">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock Name="StatusText" Text="Spreman" Margin="5,0,0,0" Foreground="#333333" />
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <TextBlock Name="StatusDateTime" Margin="0,0,5,0" Foreground="#333333" />
            </StatusBarItem>
        </StatusBar>

        <!-- Central content: tabs -->
        <Grid>
            <TabControl Name="MainTabControl" Margin="8">
                <TabItem Header="Posetioci">
                    <DataGrid Name="PosetiociGrid" ItemsSource="{Binding Posetioci}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Broj članskog" Binding="{Binding BrojClanskeKarteDisplay}" Width="140" />
                            <DataGridTextColumn Header="Ime" Binding="{Binding ImeDisplay}" Width="120" />
                            <DataGridTextColumn Header="Prezime" Binding="{Binding PrezimeDisplay}" Width="120" />
                            <DataGridTextColumn Header="Adresa" Binding="{Binding AdresaDisplay}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Autori">
                    <DataGrid Name="AutoriGrid" ItemsSource="{Binding Autori}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ime" Binding="{Binding ImeDisplay}" Width="120" />
                            <DataGridTextColumn Header="Prezime" Binding="{Binding PrezimeDisplay}" Width="120" />
                            <DataGridTextColumn Header="Broj lične karte" Binding="{Binding BrojLicneKarteDisplay}" Width="150" />
                            <DataGridTextColumn Header="Datum rođenja" Binding="{Binding DatumRodjenjaDisplay}" Width="120" />
                            <DataGridTextColumn Header="E-mejl adresa" Binding="{Binding EmailDisplay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Knjige">
                    <DataGrid Name="KnjigeGrid" ItemsSource="{Binding Knjige}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBNDisplay}" Width="120" />
                            <DataGridTextColumn Header="Naziv" Binding="{Binding NazivDisplay}" Width="*" />
                            <DataGridTextColumn Header="Cena" Binding="{Binding CenaDisplay}" Width="100" />
                            <DataGridTextColumn Header="Godina izdanja" Binding="{Binding GodinaIzdanjaDisplay}" Width="100" />
                            <DataGridTextColumn Header="Žanr" Binding="{Binding ZanrDisplay}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>