<Window x:Class="WpfClient.OdaberiIzdavacaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odaberi izdavača" Height="300" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Name="LbIzdavaci" Grid.Row="0" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Name="BtnShowBooks" Content="Prikaži knjige" Width="110" Margin="0,0,8,0" Click="BtnShowBooks_Click" />
            <Button Name="BtnOk" Content="Prikaži autore" Width="110" Margin="0,0,8,0" Click="BtnOk_Click" />
            <Button Name="BtnCancel" Content="Odustani" Width="90" Click="BtnCancel_Click" />
        </StackPanel>
    </Grid>
</Window>