<Window x:Class="WpfClient.OdaberiKnjiguDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj knjigu" Height="280" Width="270" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource tabKnjige}" 
                   Margin="0,0,0,10" FontWeight="Bold"/>
        <CheckBox x:Name="chkMultipleSelection" Grid.Row="1" 
           Content="Omogući odabir više knjiga" 
           Margin="0,0,0,10" 
           Checked="ChkMultipleSelection_Checked" 
           Unchecked="ChkMultipleSelection_Unchecked"/>

        <ListBox x:Name="lbDostupneKnjige" Grid.Row="1" 
                 SelectionMode="Single" SelectionChanged="LbDostupneKnjige_SelectionChanged" Margin="0,24,0,24">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding ISBN}"/>
                        <Run Text=" - "/>
                        <Run Text="{Binding Naziv}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnOdustani" Content="{DynamicResource btnCancel}" Width="80" Margin="0,0,10,0" 
                    IsCancel="True" Click="BtnOdustani_Click"/>
            <Button x:Name="btnPotvrdi" Content="{DynamicResource btnConfirm}" Width="80" IsEnabled="False" 
                    IsDefault="True" Click="BtnPotvrdi_Click"/>
        </StackPanel>
    </Grid>
</Window>
