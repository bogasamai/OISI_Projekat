<Window x:Class="WpfClient.PonistiKupovinuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Potvrda poništavanja kupovine" 
        Height="200" Width="400" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon -->
        <Image Grid.Row="0" Source="pack://application:,,,/System.Drawing;component/Images/Question.ico" 
               Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,15"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Message -->
        <TextBlock Grid.Row="1" x:Name="txtMessage" 
                   TextWrapping="Wrap" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   FontSize="14"
                   Margin="0,0,0,20"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnPotvrdi" Content="Potvrdi" 
                    Width="80" Height="30" 
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="BtnPotvrdi_Click"/>
            <Button x:Name="btnOdustani" Content="Odustani" 
                    Width="80" Height="30"
                    IsCancel="True"
                    Click="BtnOdustani_Click"/>
        </StackPanel>
    </Grid>
</Window>

